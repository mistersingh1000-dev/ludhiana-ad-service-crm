# Public demo: true. Production customer CRM: false after Supabase is configured.
NEXT_PUBLIC_DEMO_MODE=true
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPER_ADMIN_EMAILS=

# Encrypt per-customer Meta / WhatsApp access tokens before they are stored.
# Use 32 random bytes encoded as base64, or 64 hex characters.
INTEGRATION_ENCRYPTION_KEY=

# Meta webhooks / Graph API
META_VERIFY_TOKEN=
META_GRAPH_API_VERSION=v24.0
META_APP_SECRET=
# Optional global fallback for a single Meta Page. Multi-tenant production should connect tokens from CRM > Integrations.
META_LEAD_ACCESS_TOKEN=

# Optional global WhatsApp fallback. Multi-tenant production should connect credentials from CRM > Integrations.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
